# Copy to .env — .env is gitignored and must never be committed.
#
# Hosts allowed to serve the dashboard. Add your LAN IP / hostname.
HOMEPAGE_ALLOWED_HOSTS=localhost:3080,127.0.0.1:3080,192.168.1.10:3080

# Optional: API keys for service widgets. Reference them in services.yaml as
# {{HOMEPAGE_VAR_SONARR_KEY}} so the committed config holds no secret.
# HOMEPAGE_VAR_SONARR_KEY=
# HOMEPAGE_VAR_RADARR_KEY=
