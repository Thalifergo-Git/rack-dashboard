# Run this on each MONITORED host that does NOT have Docker —
# a Proxmox hypervisor, a bare VM, a router you can install packages on.
#
#   sudo apt-get install -y glances
#   sudo curl -fsSL -o /etc/systemd/system/glances-web.service \
#        https://raw.githubusercontent.com/<you>/rack-dashboard/main/agent/glances-web.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now glances-web
#
# Exposes a read-only REST API on :61208. NO AUTHENTICATION — LAN or VPN only.
# To restrict it to one interface, change --bind to that address.
[Unit]
Description=Glances REST API for Rack Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/glances -w --disable-webui --bind 0.0.0.0 --port 61208
Restart=on-failure
RestartSec=10
User=root
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
